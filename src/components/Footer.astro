---
import { href, ui, type Lang, type Page } from '../i18n/ui';
import BrandLogo from './BrandLogo.astro';
import { site } from '../data/site';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const legal: Page[] = ['legal', 'privacy', 'cookies'];
---

<footer class="site-footer">
  <div class="container footer-main">
    <div>
      <a href={href(lang)}><BrandLogo loading="lazy" /></a><p>{t.footerLine}</p>
      <div class="footer-contact">
        <a href={site.contact.emailHref}>{site.contact.email}</a><a
          href={site.contact.phoneHref}>{site.contact.phone}</a
        >
      </div>
    </div>
    <nav aria-label={lang === 'ca' ? 'Enllaços del peu' : 'Enlaces del pie'}>
      {
        (['studio', 'services', 'contact'] as Page[]).map((key) => (
          <a href={href(lang, key)}>{t.nav[key]}</a>
        ))
      }
    </nav>
  </div>
  <div class="container footer-bottom">
    <small>© {new Date().getFullYear()} Habitalia Consulting. {t.rights}</small
    ><nav aria-label={lang === 'ca' ? 'Informació legal' : 'Información legal'}>
      {legal.map((key) => <a href={href(lang, key)}>{t.nav[key]}</a>)}
    </nav>
  </div>
</footer>
